# =============================================================================
# MongoDB Atlas Database Connection Configuration (Template)
# Replace <username>, <password>, and <cluster-address> with your actual Atlas cluster details.
# =============================================================================
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/imovies?retryWrites=true&w=majority

# Local fallback URI
MONGO_URI=mongodb://localhost:27017/imovies

# Server Configuration
PORT=5050
CLIENT_URL=http://localhost:5173
JWT_SECRET=your_jwt_secret_key_here

# Notification & Mailer Config
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# TMDB Movie Database API
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.tmdb.org/3

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
